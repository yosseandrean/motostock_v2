# SQLite database file. Prisma 7 resolves this relative to the repo root
# (where prisma.config.ts lives), not the prisma/ directory.
DATABASE_URL="file:./prisma/dev.db"

# Secret used to sign the 30-day session cookie. Use a long random string in production.
SESSION_SECRET="change-me-to-a-long-random-string"

# The single shared password used to log in.
SHARED_PASSWORD="change-me"

# Public hostname of the VPS (used only by the Docker deployment's Caddy
# reverse proxy to obtain the HTTPS certificate). Not needed for local dev.
MOTOSTOCK_DOMAIN="stok.example.com"
